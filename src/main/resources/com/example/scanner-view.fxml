<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.Controller">
    <!-- Top Control Panel -->
    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Target Directory:" />
                        <TextField fx:id="pathTextField" promptText="Select or paste a directory path..." HBox.hgrow="ALWAYS" />
                        <Button fx:id="browseButton" onAction="#handleBrowse" text="Browse..." />
                        <Button fx:id="scanButton" onAction="#handleScan" style="-fx-base: #2ecc71; -fx-text-fill: white;" text="Start Scan" />
                        <Button fx:id="cancelButton" disable="true" onAction="#handleCancel" style="-fx-base: #e74c3c; -fx-text-fill: white;" text="Cancel" />
                        <Button onAction="#handleFetchApiData" style="-fx-base: #3498db; -fx-text-fill: white;" text="Inspect Format" />
                        <Button onAction="#handleShowHistory" style="-fx-base: #8e44ad; -fx-text-fill: white;" text="View History" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0.0" HBox.hgrow="ALWAYS" />
                        <Label fx:id="statusLabel" text="Ready" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <!-- Main Content Area: Tree on Left, Table on Right -->
    <center>
        <SplitPane dividerPositions="0.3" BorderPane.alignment="CENTER">
            <items>
                <!-- Directory Hierarchy -->
                <VBox spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Folder Structure">
                            <VBox.margin>
                                <Insets left="5.0" top="5.0" />
                            </VBox.margin>
                        </Label>
                        <TreeView fx:id="directoryTreeView" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>

                <!-- Scanned Files Detail Table with Search Bar -->
                <VBox spacing="5.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <padding>
                                <Insets left="5.0" right="5.0" top="5.0" />
                            </padding>
                            <children>
                                <Label style="-fx-font-weight: bold;" text="File Details" />
                                <HBox HBox.hgrow="ALWAYS" />
                                <TextField fx:id="searchTextField" prefWidth="220.0" promptText="🔍 Search files by name..." />
                            </children>
                        </HBox>
                        <TableView fx:id="fileTableView" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colName" prefWidth="200.0" text="File Name" />
                                <TableColumn fx:id="colSize" prefWidth="100.0" text="Size" />
                                <TableColumn fx:id="colExtension" prefWidth="80.0" text="Type" />
                                <TableColumn fx:id="colPath" prefWidth="300.0" text="Full Path" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox spacing="20.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
            <children>
                <Label fx:id="totalFilesLabel" text="Total Files: 0" />
                <Label fx:id="totalSizeLabel" text="Total Size: 0 KB" />
            </children>
        </HBox>
    </bottom>
</BorderPane>