<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="480.0" prefWidth="950.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.HistoryController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <VBox prefWidth="320.0" spacing="8.0">
            <children>
                <ListView fx:id="historyListView" VBox.vgrow="ALWAYS" />
                <HBox spacing="8.0">
                    <children>
                        <Button onAction="#handleLoadSelectedScan" style="-fx-base: #3498db; -fx-text-fill: white;" text="Load" />
                        <Button onAction="#handleEditNote" style="-fx-base: #f39c12; -fx-text-fill: white;" text="Edit Note" />
                        <Button onAction="#handleDeleteScan" style="-fx-base: #e74c3c; -fx-text-fill: white;" text="Delete" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <PieChart fx:id="countChart" title="File Types (Count)" HBox.hgrow="ALWAYS" />
        <PieChart fx:id="sizeChart" title="File Types (Size in MB)" HBox.hgrow="ALWAYS" />
    </children>
</HBox>